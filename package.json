{
  "name": "tenang-berkebun-ae-30s",
  "version": "1.0.0",
  "private": true,
  "description": "30s After-Effects Camera Motion Graphic - Kenapa Berkebun Bikin Tenang (Seflorner)",
  "scripts": {
    "generate:audio": "node scripts/generate-audio.mjs",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "build": "remotion render src/index.ts TenangBerkebunAE out/tenang-berkebun-30s.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
